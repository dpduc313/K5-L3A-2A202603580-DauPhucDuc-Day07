# Chép file này thành .env rồi điền giá trị. Không commit .env (đã có trong .gitignore).

# ---------------------------------------------------------------------------
# Bắt buộc cho bài lab
# ---------------------------------------------------------------------------

# Postgres + pgvector của Lab07 (compose.yaml), port 55434.
DATABASE_URL=postgresql://day7:day7_local_only@127.0.0.1:55434/day7_lab

# Model của agent (tool calling). Chính: gpt-5.4-nano; đo lại: gpt-5.4-mini (chạy trên dev trước).
OPENAI_API_KEY=
LAB_AGENT_MODEL=gpt-5.4-nano

# Ollama local cho embedding (embeddinggemma-2, 768 chiều, giống Day 6).
# Cần chạy trước: ollama pull embeddinggemma-2
PERRY_OLLAMA_URL=http://127.0.0.1:11434

# Reranker mặc định của Perrier (ms-marco, chỉ tiếng Anh) bị src/lab_config.py tắt cho mọi
# lệnh của lab, kể cả khi dòng này trống (trên Windows biến rỗng bị xóa, nên không tự tắt được).
# Cấu hình có rerank chọn model trong code thí nghiệm. Chỉ điền nếu muốn bật cho chat Perrier.
PERRY_RERANK_MODEL=

# ---------------------------------------------------------------------------
# Chỉ cần khi mở giao diện chat của Perrier (python -m src.perry_app web)
# ---------------------------------------------------------------------------

GEMINI_API_KEY=
PERRY_LLM_MODEL=
# Chuỗi ngẫu nhiên dài, dùng để ký cookie phiên đăng nhập.
PERRY_SESSION_SECRET=
PERRY_PAID_CHAT_ONLY=

# Tùy chọn: gửi trace sang LangSmith. Đây là dịch vụ ngoài: kiểm tra quyền dữ liệu
# trước khi bật (RULES.md). Để trống thì không gửi.
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
